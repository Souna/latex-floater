{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaTeX Floater",
  "version": "0.2.0",
  "identifier": "com.local.latexfloater",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run vendor",
    "beforeBuildCommand": "npm run vendor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LaTeX Floater",
        "width": 620,
        "height": 380,
        "minWidth": 480,
        "minHeight": 280,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "backgroundColor": "#12131a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
